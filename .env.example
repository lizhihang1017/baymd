# ============================================================
# BayMD 部署配置示例 — 复制为 .env 后按需修改
#   cp .env.example .env
# ============================================================

# 百炼(阿里云) API Key — 必填(不填则使用 application.yaml 内置 key)
# 获取地址: https://bailian.console.aliyun.com/
BAILIAN_API_KEY=

# 前端对外端口(默认 80,可改为 5173 等)
WEB_PORT=80

# 邮件随访(可选) — 配置后开启 rag.followup.enabled=true
# QQ/163 邮箱请使用「授权码」而非登录密码
MAIL_HOST=smtp.qq.com
MAIL_USERNAME=
MAIL_PASSWORD=
